      "sourceUrl": "https://takken-success.info/2022kakomon/r04-37/",
      "verdict": "ok"
    },
    "r4-39": {
      "checkedAt": "2026-09-09T20:12:50.086979+09:00",
      "message": "解説と一致。供託先、分担金は現金のみ、社員となる前の取引債権も保証対象という点はすべて正しい。",
