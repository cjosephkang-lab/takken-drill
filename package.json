{
  "name": "takken-drill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://cjosephkang-lab.github.io/takken-drill",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data": "python3 scripts/build-data.py",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dotfiles",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "gh-pages": "latest",
    "playwright": "^1.63.0",
    "postcss": "^8.5.25",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.10"
  }
}
